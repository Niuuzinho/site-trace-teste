---
layout: null
permalink: /search.json
---
[
{%- assign todos = site.projetos | where_exp: "p", "p.par == nil" | concat: site.producoes -%}
{%- for d in todos %}
  {
    "titulo": {{ d.title | jsonify }},
    "url": {{ d.url | relative_url | jsonify }},
    "tipo": {% if d.collection == 'projetos' %}"Projeto"{% else %}{{ d.tipo | jsonify }}{% endif %},
    "ano": {{ d.ano | jsonify }},
    "resumo": {{ d.resumo | jsonify }},
    "projeto": {{ d.projeto | jsonify }},
    "temas": {% if d.collection == 'projetos' %}{{ d.temas | jsonify }}{% else %}{{ d.palavras_chave | jsonify }}{% endif %}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
